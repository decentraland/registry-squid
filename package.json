{
  "name": "registry-squid",
  "private": true,
  "description": "Indexes Decentraland's LAND permissions, rentals and third-party registry",
  "license": "MIT",
  "repository": "github:decentraland/registry-squid",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "test": "npm run build && node --test \"lib/**/*.test.js\"",
    "codegen": "squid-typeorm-codegen",
    "typegen": "squid-evm-typegen ./src/abi ./abi/*.json",
    "db:migrate": "squid-typeorm-migration apply",
    "migration:generate": "squid-typeorm-migration generate",
    "processor:ethereum": "node lib/ethereum/main.js",
    "processor:polygon": "node lib/polygon/main.js",
    "serve": "squid-graphql-server --dialect thegraph"
  },
  "dependencies": {
    "@subsquid/batch-processor": "^1.1.0",
    "@subsquid/evm-abi": "^0.3.1",
    "@subsquid/evm-codec": "^0.3.0",
    "@subsquid/evm-objects": "^0.0.3",
    "@subsquid/evm-stream": "^0.1.4",
    "@subsquid/graphql-server": "^4.9.0",
    "@subsquid/logger": "^1.3.3",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.9.2",
    "@subsquid/util-internal": "^3.2.0",
    "dotenv": "^16.4.5",
    "pg": "^8.11.5",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@subsquid/evm-typegen": "^4.3.0",
    "@subsquid/typeorm-codegen": "^2.0.2",
    "@types/node": "^20.12.7",
    "typescript": "~5.4.5"
  }
}
